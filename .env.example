DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=monitor.example.com
MYSQL_DATABASE=cronos
MYSQL_USER=cronos
MYSQL_PASSWORD=set-a-strong-database-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
DEVICE_ENCRYPTION_KEY=generate-a-fernet-key
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://localhost,https://monitor.example.com
# RabbitMQ stays private to the backend; clients use the authenticated WebSocket gateway.
RABBITMQ_URL=amqp://cronos:change-this-broker-password@rabbitmq:5672/cronos
RABBITMQ_EXCHANGE=cronos.notifications
# Docker RabbitMQ initialization only; match RABBITMQ_URL above.
RABBITMQ_DEFAULT_USER=cronos
RABBITMQ_DEFAULT_PASS=change-this-broker-password
RABBITMQ_DEFAULT_VHOST=cronos
CRONOS_DEMO_MODE=false
PROBE_ALLOWED_CIDRS=
PROBE_DENIED_HOSTS=localhost,metadata.google.internal,metadata,monitor.example.com
# Docker MySQL initialization only; distinct from the application password.
MYSQL_ROOT_PASSWORD=set-another-strong-password
