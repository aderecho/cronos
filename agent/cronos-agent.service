[Unit]
Description=Cronos server telemetry agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cronos-agent
Group=cronos-agent
WorkingDirectory=/opt/cronos-agent
EnvironmentFile=/etc/cronos-agent.env
ExecStart=/opt/cronos-agent/.venv/bin/python /opt/cronos-agent/cronos_agent.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
