    "capacitor-secure-storage-plugin": "^0.13.0",
    "chart.js": "^4.5.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.56.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass-embedded": "^1.93.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
